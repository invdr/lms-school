#!/usr/bin/env bash
set -euo pipefail
check_push=0
while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ ! "$local_sha" =~ ^0+$ ]]; then
        check_push=1
        if [[ "$local_sha" != "$(git rev-parse HEAD)" ]]; then
            echo "Check out the commit being pushed before running local checks." >&2
            exit 1
        fi
    fi
done
if [[ "$check_push" == 0 ]]; then
    exit 0
fi
cd "$(git rev-parse --show-toplevel)"
if [[ -n "$(git status --porcelain --untracked-files=all)" ]]; then
    echo "Commit the working tree before pushing so checks validate the pushed code." >&2
    exit 1
fi
# CI owns the heavy gate. Merge/release still requires checks on the exact commit.
bash tools/check-quick.sh
if [[ -n "$(git status --porcelain --untracked-files=all)" ]]; then
    echo "The working tree changed during checks; review and commit before pushing." >&2
    exit 1
fi
