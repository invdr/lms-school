{
	"name": "frappe_lms",
	"version": "1.0.0",
	"description": "Easy to use, open-source, Learning Management System",
	"type": "module",
	"workspaces1": [
		"frappe-ui",
		"frontend"
	],
	"scripts": {
		"postinstall": "corepack yarn --cwd frontend install --frozen-lockfile --check-files",
		"dev": "cd frontend && yarn dev",
		"build": "cd frontend && yarn build",
		"check:local": "bash tools/check-local.sh",
		"check:quick": "bash tools/check-quick.sh",
		"check:backend": "bash tools/check-backend.sh",
		"hooks:install": "git config core.hooksPath .githooks"
	},
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frappe/lms.git"
	},
	"author": "Frappe",
	"license": "AGPL-3.0-or-later",
	"bugs": {
		"url": "https://github.com/frappe/lms/issues"
	},
	"homepage": "https://github.com/frappe/lms#readme",
	"engines": {
		"node": ">=22"
	}
}
